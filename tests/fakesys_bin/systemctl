#!/usr/bin/env python3
"""Fake systemctl for install_sim.sh: unit files in $FAKESYS/etc/systemd/system, services really run."""
import os, re, shlex, signal, subprocess, sys, time
F = os.environ["FAKESYS"]; UD = F + "/etc/systemd/system"; ST = F + "/state"; os.makedirs(ST, exist_ok=True)
open(F + "/systemctl.log", "a").write(" ".join(sys.argv[1:]) + "\n")
def path(n):
    for c in (n, n + ".service"):
        if os.path.exists(os.path.join(UD, c)): return os.path.join(UD, c)
def norm(n): return n if n.endswith((".service", ".target")) else n + ".service"
def field(n, k):
    p = path(n)
    if not p: return ""
    m = re.findall(r"^%s=(.*)$" % k, open(p).read(), re.M)
    return m[0] if m else ""
def pid(n):
    try: p = int(open(os.path.join(ST, norm(n) + ".pid")).read())
    except (OSError, ValueError): return None
    try: os.kill(p, 0); return p
    except OSError: return None
def stop(n):
    p = pid(n)
    if p:
        try: os.killpg(p, signal.SIGTERM)
        except OSError: pass
        for _ in range(50):
            if pid(n) is None: break
            try: os.waitpid(p, os.WNOHANG)
            except OSError: pass
            time.sleep(0.1)
def members(t): return field(t, "Wants").split()
def start(n):
    n = norm(n)
    if n.endswith(".target"):
        for m in members(n): start(m)
        return
    if pid(n): return
    cmd = field(n, "ExecStart")
    if not cmd: print("Unit %s not found." % n, file=sys.stderr); sys.exit(5)
    wd = field(n, "WorkingDirectory") or "/"
    env = dict(os.environ, PYTHONUNBUFFERED="1")
    p = subprocess.Popen(shlex.split(cmd), cwd=wd, stdout=open(os.path.join(ST, n + ".log"), "a"), stderr=subprocess.STDOUT, env=env, start_new_session=True)
    open(os.path.join(ST, n + ".pid"), "w").write(str(p.pid)); open(os.path.join(ST, n + ".since"), "w").write(time.strftime("%a %Y-%m-%d %H:%M:%S UTC", time.gmtime()))
def restart(n):
    n = norm(n)
    if n.endswith(".target"):
        for m in members(n): restart(m)
        return
    stop(n); start(n)
a = sys.argv[1:]; quiet = "--quiet" in a; a = [x for x in a if x not in ("--quiet", "--no-pager")]
cmd = a[0] if a else ""; rest = a[1:]
if cmd == "cat":
    p = path(rest[0]); 
    if not p: sys.exit(1)
    print("# " + p); print(open(p).read()); sys.exit(0)
if cmd == "show":
    n = rest[0]; prop = rest[rest.index("-p") + 1]
    if prop == "ExecStart":
        e = field(n, "ExecStart"); print("{ path=%s ; argv[]=%s ; }" % (e.split()[0], e) if e else "")
    elif prop == "ActiveState": print("active" if pid(n) else ("inactive" if path(n) else ""))
    elif prop == "ActiveEnterTimestamp":
        try: print(open(os.path.join(ST, norm(n) + ".since")).read())
        except OSError: print("")
    sys.exit(0)
if cmd == "is-enabled":
    e = os.path.exists(os.path.join(ST, norm(rest[0]) + ".enabled")); 
    if not quiet: print("enabled" if e else ("disabled" if path(rest[0]) else "not-found"))
    sys.exit(0 if e else 1)
if cmd == "is-active":
    ok = pid(rest[0]) is not None
    if not quiet: print("active" if ok else "inactive")
    sys.exit(0 if ok else 3)
if cmd == "daemon-reload": sys.exit(0)
if cmd in ("enable", "disable"):
    now = "--now" in rest; names = [x for x in rest if x != "--now"]
    for n in names:
        f = os.path.join(ST, norm(n) + ".enabled")
        if cmd == "enable": open(f, "w").close(); now and start(n)
        else:
            if os.path.exists(f): os.remove(f)
            if now:
                if norm(n).endswith(".target"):
                    for m in members(n): stop(m)
                else: stop(n)
    sys.exit(0)
if cmd in ("start", "stop", "restart"):
    for n in rest:
        if cmd == "stop":
            if norm(n).endswith(".target"):
                for m in members(n): stop(m)
            else: stop(n)
        elif cmd == "start": start(n)
        else: restart(n)
    sys.exit(0)
print("fake systemctl: unsupported %s" % a, file=sys.stderr); sys.exit(1)
